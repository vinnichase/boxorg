{
    "name": "boxorg",
    "main": "expo-router/entry",
    "version": "1.0.0",
    "scripts": {
        "build:ios": "eas build --profile preview --platform ios",
        "build:android": "eas build --profile preview --platform android",
        "start": "expo start",
        "reset-project": "node ./scripts/reset-project.js",
        "android": "BUILD_PROFILE=dev expo run android",
        "ios": "BUILD_PROFILE=dev expo start --ios",
        "dev": "BUILD_PROFILE=dev expo start",
        "prebuild": "BUILD_PROFILE=dev expo prebuild",
        "doctor": "BUILD_PROFILE=dev npx expo-doctor",
        "web": "expo start --web",
        "test": "jest --watchAll",
        "lint": "expo lint"
    },
    "jest": {
        "preset": "jest-expo"
    },
    "expo": {
        "doctor": {
            "reactNativeDirectoryCheck": {
                "listUnknownPackages": false
            }
        },
        "autolinking": {
            "android": {
                "buildFromSource": [
                    ".*"
                ]
            }
        }
    },
    "dependencies": {
        "@babel/runtime": "^7.29.7",
        "@expo/metro-runtime": "^57.0.16",
        "@expo/vector-icons": "^15.1.1",
        "@gothub-team/got-atom": "^0.24.4",
        "expo": "~57.0.26",
        "expo-blur": "~57.0.3",
        "expo-build-properties": "~57.0.22",
        "expo-constants": "~57.0.20",
        "expo-file-system": "~57.0.7",
        "expo-font": "~57.0.4",
        "expo-image-manipulator": "~57.0.20",
        "expo-image-picker": "~57.0.20",
        "expo-linking": "~57.0.11",
        "expo-router": "~57.0.24",
        "expo-splash-screen": "~57.0.9",
        "expo-sqlite": "~57.0.3",
        "expo-status-bar": "~57.0.1",
        "expo-updates": "~57.0.24",
        "fast-deep-equal": "^3.1.3",
        "react": "19.2.3",
        "react-dom": "19.2.3",
        "react-native": "0.86.3",
        "react-native-gesture-handler": "~2.32.0",
        "react-native-keyboard-controller": "1.21.9",
        "react-native-reanimated": "~4.5.1",
        "react-native-safe-area-context": "^5.7.0",
        "react-native-screens": "~4.26.2",
        "react-native-svg": "^15.15.4",
        "react-native-worklets": "0.10.1"
    },
    "devDependencies": {
        "@babel/core": "^7.29.7",
        "@types/jest": "^29.5.14",
        "@types/react": "~19.2.17",
        "@types/react-test-renderer": "^19.1.0",
        "eslint": "^9.39.4",
        "eslint-config-expo": "~57.0.2",
        "jest": "^29.7.0",
        "jest-expo": "~57.0.5",
        "react-test-renderer": "19.1.0",
        "typescript": "^6.0.3"
    },
    "private": true
}
