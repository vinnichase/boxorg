{
    "name": "boxorg",
    "main": "expo-router/entry",
    "version": "1.0.0",
    "scripts": {
        "build:ios": "eas build --profile preview --platform ios",
        "build:android": "eas build --profile preview --platform android",
        "start": "expo start",
        "reset-project": "node ./scripts/reset-project.js",
        "android": "BUILD_PROFILE=dev expo run android",
        "ios": "BUILD_PROFILE=dev expo run ios -d \"iPhone (8)\"",
        "prebuild": "BUILD_PROFILE=dev expo prebuild",
        "doctor": "BUILD_PROFILE=dev npx expo-doctor",
        "web": "expo start --web",
        "test": "jest --watchAll",
        "lint": "expo lint"
    },
    "jest": {
        "preset": "jest-expo"
    },
    "expo": {
        "doctor": {
            "reactNativeDirectoryCheck": {
                "listUnknownPackages": false
            }
        }
    },
    "dependencies": {
        "@babel/runtime": "^7.28.4",
        "@expo/metro-runtime": "^6.1.2",
        "@expo/vector-icons": "^15.0.3",
        "@gothub-team/got-atom": "^0.24.4",
        "@react-native-community/image-editor": "^4.3.0",
        "expo": "~54.0.20",
        "expo-blur": "~15.0.7",
        "expo-constants": "~18.0.10",
        "expo-file-system": "~19.0.17",
        "expo-font": "~14.0.9",
        "expo-image-picker": "~17.0.8",
        "expo-linking": "~8.0.8",
        "expo-router": "~6.0.13",
        "expo-splash-screen": "~31.0.10",
        "expo-sqlite": "~16.0.8",
        "fast-deep-equal": "^3.1.3",
        "react": "19.1.0",
        "react-dom": "19.1.0",
        "react-native": "0.81.5",
        "react-native-gesture-handler": "~2.28.0",
        "react-native-reanimated": "~4.1.3",
        "react-native-safe-area-context": "^5.6.1",
        "react-native-screens": "~4.16.0",
        "react-native-svg": "^15.12.1",
        "react-native-worklets": "0.5.1"
    },
    "devDependencies": {
        "@babel/core": "^7.25.2",
        "@types/jest": "^29.5.12",
        "@types/react": "~19.1.17",
        "@types/react-test-renderer": "^18.3.0",
        "jest": "^29.2.1",
        "jest-expo": "~54.0.13",
        "react-test-renderer": "18.3.1",
        "typescript": "^5.9.3"
    },
    "private": true
}
