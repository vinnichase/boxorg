{
    "name": "boxorg",
    "main": "expo-router/entry",
    "version": "1.0.0",
    "scripts": {
        "build:ios": "eas build --profile preview --platform ios",
        "build:android": "eas build --profile preview --platform android",
        "start": "expo start",
        "reset-project": "node ./scripts/reset-project.js",
        "android": "BUILD_PROFILE=dev expo run android",
        "ios": "BUILD_PROFILE=dev expo run ios -d \"iPhone (8)\"",
        "prebuild": "BUILD_PROFILE=dev expo prebuild",
        "doctor": "BUILD_PROFILE=dev npx expo-doctor",
        "web": "expo start --web",
        "test": "jest --watchAll",
        "lint": "expo lint"
    },
    "jest": {
        "preset": "jest-expo"
    },
    "expo": {
        "doctor": {
            "reactNativeDirectoryCheck": {
                "listUnknownPackages": false
            }
        }
    },
    "dependencies": {
        "@babel/runtime": "^7.29.7",
        "@expo/metro-runtime": "^56.0.15",
        "@expo/vector-icons": "^15.1.1",
        "@gothub-team/got-atom": "^0.24.4",
        "@react-native-community/image-editor": "^4.3.0",
        "expo": "~56.0.12",
        "expo-blur": "~56.0.3",
        "expo-constants": "~56.0.18",
        "expo-file-system": "~56.0.8",
        "expo-font": "~56.0.7",
        "expo-image-picker": "~56.0.18",
        "expo-linking": "~56.0.14",
        "expo-router": "~56.2.11",
        "expo-splash-screen": "~56.0.10",
        "expo-sqlite": "~56.0.5",
        "expo-status-bar": "~56.0.4",
        "fast-deep-equal": "^3.1.3",
        "react": "19.2.3",
        "react-dom": "19.2.3",
        "react-native": "0.85.3",
        "react-native-gesture-handler": "~2.31.2",
        "react-native-keyboard-controller": "1.21.6",
        "react-native-reanimated": "~4.3.1",
        "react-native-safe-area-context": "^5.7.0",
        "react-native-screens": "~4.25.2",
        "react-native-svg": "^15.15.4",
        "react-native-worklets": "0.8.3"
    },
    "devDependencies": {
        "@babel/core": "^7.29.7",
        "@react-native/jest-preset": "0.85.3",
        "@types/jest": "^29.5.14",
        "@types/react": "~19.2.17",
        "@types/react-test-renderer": "^19.1.0",
        "eslint": "^9.39.4",
        "eslint-config-expo": "~56.0.4",
        "jest": "^29.7.0",
        "jest-expo": "~56.0.5",
        "react-test-renderer": "19.2.3",
        "typescript": "^6.0.3"
    },
    "private": true
}
