{
    "cli": {
        "version": ">= 16.0.1",
        "appVersionSource": "remote"
    },
    "build": {
        "development": {
            "developmentClient": true,
            "distribution": "internal"
        },
        "preview": {
            "distribution": "internal",
            "channel": "preview"
        },
        "production": {
            "autoIncrement": true,
            "channel": "production",
            "android": {
                "buildType": "apk"
            }
        },
        "izzy": {
            "extends": "production",
            "env": {
                "IZZY_BUILD": "1",
                "ORG_GRADLE_PROJECT_reactNativeArchitectures": "arm64-v8a"
            }
        }
    },
    "submit": {
        "production": {}
    }
}